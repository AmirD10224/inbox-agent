# InboxAgent. environment configuration
# Copy to .env and fill in real values. Never commit .env.

# --- Anthropic ---
# Required. Used by the single LLM client wrapper.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model selection. Defaults match production. Override only for experiments.
ANTHROPIC_MODEL_PRIMARY=claude-sonnet-4-6
ANTHROPIC_MODEL_JUDGE=claude-haiku-4-5-20251001

# --- Voyage (embeddings for FAQ retrieval) ---
# Required for /ingest-faq. Get free tier at https://www.voyageai.com
VOYAGE_API_KEY=pa-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
VOYAGE_EMBED_MODEL=voyage-3

# --- Postgres ---
# Local dev (compose.yml provides this). For Modal/prod use a managed instance.
DATABASE_URL=postgresql+psycopg://inbox:inbox@localhost:5432/inbox_agent

# --- Langfuse (observability) ---
# Free tier at https://cloud.langfuse.com. leave blank to disable tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated origins for CORS. "*" allowed in dev; never in prod.
CORS_ORIGINS=http://localhost:3000

# --- Frontend (apps/web/.env.local) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
